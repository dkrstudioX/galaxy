%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!1 &1
NetworkManager:
  m_ObjectHideFlags: 0
  m_DebugLevel: 0
  m_EnableHostBuilder: 0
  m_UseWebSockets: 0
  m_UseEncryption: 0
  m_MaxPacketSize: 1400
  m_AffinityMask: 0
  m_ReceiveTimeout: 3000
  m_SendTimeout: 3000
  m_EnableSecurity: 0
  m_EnableMetrics: 0
  m_EnableStats: 0
